name: Linen frozen local build
on:
  push:
    branches: [qa/linen-local-editor-20261111-build-1]
permissions:
  contents: read
concurrency:
  group: linen-local-editor-build-1
  cancel-in-progress: false
jobs:
  frozen-build:
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    env:
      SOURCE_COMMIT: CHECKED_SOURCE_COMMIT
    steps:
      - name: Record earliest job clock
        run: echo "LN_BUILD_JOB_STARTED_MS=$(date +%s%3N)" >> "$GITHUB_ENV"
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          ref: ${{ env.SOURCE_COMMIT }}
          fetch-depth: 0
          persist-credentials: false
      - uses: actions/setup-node@249970729cb0ef3589644e2896645e5dc5ba9c38
        with:
          node-version: 24.22.2
          check-latest: false
      - name: Run frozen local build
        run: python3 -I -S -B scripts/ci-build.py --source-commit "$SOURCE_COMMIT"
      - name: Upload original evidence
        id: proof
        if: ${{ always() && env.LN_BUILD_PROOF_PATH != '' }}
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9
        with:
          name: linen-frozen-build-${{ github.run_id }}
          path: ${{ env.LN_BUILD_PROOF_PATH }}
          include-hidden-files: false
          if-no-files-found: error
          retention-days: 14
          compression-level: 6
      - name: Retire uploaded proof
        if: ${{ always() && steps.proof.outcome == 'success' }}
        run: python3 -I -S -B scripts/ci-build.py --cleanup-proof
